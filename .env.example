# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Never expose this key in client-side code or VITE_ variables.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_PLACEHOLDER"

# APP_URL: The canonical production HTTPS URL where this application is hosted.
APP_URL="https://www.xongle.xyz"

# GOOGLE_SITE_VERIFICATION: Optional non-secret Google Search Console HTML meta tag verification token.
GOOGLE_SITE_VERIFICATION="xOeUw5KxdZxm7_CM5n3nsq16k29jSyXLfOE_INHWzjo"
VITE_GOOGLE_SITE_VERIFICATION="xOeUw5KxdZxm7_CM5n3nsq16k29jSyXLfOE_INHWzjo"

# NODE_ENV: Deployment environment ('development' | 'production' | 'test')
NODE_ENV="development"

# SESSION_SECRET: High-entropy secret (min 32 bytes) used for HMAC signing of HttpOnly session cookies and CSRF tokens.
SESSION_SECRET="REPLACE_WITH_64_CHAR_HEX_RANDOM_SESSION_SECRET"

# OWNER_EMAILS: Comma-separated list of authorized owner email addresses verified on the server.
OWNER_EMAILS="aminbek785@gmail.com,crownsmpuz@gmail.com"

# FIREBASE_PROJECT_ID: Firebase project ID used for server-side JWT audience/issuer verification.
FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"

# TURNSTILE_SECRET_KEY: Optional Cloudflare Turnstile / CAPTCHA secret key for server-side bot verification.
TURNSTILE_SECRET_KEY=""



